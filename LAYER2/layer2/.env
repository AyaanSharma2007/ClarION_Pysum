DATABASE_URL=postgresql+asyncpg://postgres.pnkwdtuuzwravayzmyru:8GF7Qxs31uWF8vkG@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres?prepared_statement_cache_size=0

# ─── Embeddings ────────────────────────────────────────────────────────────────
