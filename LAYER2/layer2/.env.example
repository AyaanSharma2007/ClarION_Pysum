# ─── Database ──────────────────────────────────────────────────────────────────
# Local dev (matches docker-compose.yml defaults)
DATABASE_URL=postgresql+asyncpg://rfi_user:rfi_pass@localhost:5432/rfi_nexus

# Supabase (swap in when your teammate shares the project URL + service-role key)
# DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# ─── Embeddings ────────────────────────────────────────────────────────────────
# "sentence_transformers" = local model, no key needed (default)
# "voyage"                = Voyage AI API (faster, better quality)
EMBEDDING_BACKEND=sentence_transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Fill in when you have a Voyage AI key:
# EMBEDDING_BACKEND=voyage
# EMBEDDING_MODEL=voyage-large-2
# EMBEDDING_DIMENSION=1536
# VOYAGE_API_KEY=pa-...

# ─── Entity Extraction ─────────────────────────────────────────────────────────
# "stub" = returns null (safe default, Layer 3 backfills later)
# "claude" = Anthropic Claude API
EXTRACTION_BACKEND=stub

# Fill in when you have an Anthropic key:
# EXTRACTION_BACKEND=claude
# ANTHROPIC_API_KEY=sk-ant-...

# ─── Auth ──────────────────────────────────────────────────────────────────────
# false = no auth, all endpoints open (dev default)
AUTH_ENABLED=false

# Fill in when you have Supabase Auth:
# AUTH_ENABLED=true
# SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ─── Workflow ──────────────────────────────────────────────────────────────────
SLA_HOURS_DEFAULT=72

# ─── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ─── Neo4j (Layer 3 graph — hybrid search enrichment) ────────────────────────
# Leave NEO4J_PASSWORD unset (or commented out) to run Layer 2 without Neo4j.
# POST /search/hybrid will still work but graph fields will be null.
# Fill in when your Layer 3 teammate has Neo4j running:
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=your_neo4j_password
# NEO4J_DATABASE=neo4j
