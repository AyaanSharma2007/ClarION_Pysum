# RFI Nexus Data Mesh Intake Backend Environment Configuration

# FastAPI Settings
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Anthropic Claude API Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Supabase Storage & Database Configuration
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# Layer 2 Central Repository (pgvector + audit trail)
# Set this to the URL where Layer 2 is running (default: http://localhost:8001)
LAYER2_URL=http://localhost:8001
